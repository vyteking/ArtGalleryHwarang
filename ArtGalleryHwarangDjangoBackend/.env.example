# .env.example - A template for developers.
# Copy this file to .env and fill in your actual secret values.

# Django
SECRET_KEY='your-secret-key-goes-here'
DEBUG=True
ALLOWED_HOSTS=localhost

# PostgreSQL — relational/transactional data (users, auth, follows)
DB_NAME=hwarang
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# MongoDB — document data (posts, replies, content) via Beanie/Motor
MONGO_URI=mongodb://localhost:27017/hwarang

# Redis — caching, rate limiting, pub/sub
REDIS_URI=redis://localhost:6379/0

# Elasticsearch — full-text search
ELASTICSEARCH_URI=http://localhost:9200
